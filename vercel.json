{
  "rewrites": [
    { "source": "/post/:id", "has": [{ "type": "header", "key": "user-agent", "value": ".*(Discordbot|Twitterbot|facebookexternalhit|Slackbot|TelegramBot|WhatsApp|LinkedInBot|Mastodon|Embedly).*" }], "destination": "/api/post?id=:id" },
    { "source": "/@:u", "has": [{ "type": "header", "key": "user-agent", "value": ".*(Discordbot|Twitterbot|facebookexternalhit|Slackbot|TelegramBot|WhatsApp|LinkedInBot|Mastodon|Embedly).*" }], "destination": "/api/post?u=:u" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
